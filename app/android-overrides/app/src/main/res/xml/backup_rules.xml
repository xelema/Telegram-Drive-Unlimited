<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Telegram sessions, vault material, transfer queues, and cached files must
         never leave the device through Android's legacy backup transport. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
